PORT=3000
DATABASE_URL=postgres://electricos:CAMBIAR@192.168.99.12:5432/electricos
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO
ADMIN_EMAIL=admin@infratec.com.uy
# Solo para crear el primer administrador: borrala del .env después del primer arranque
ADMIN_PASSWORD=CAMBIAR
TZ_LOCAL=America/Montevideo
# Contraseña compartida para cargadores (OCPP Security Profile 1/2, Basic Auth) para los que no tienen una propia.
# Vacío = cualquiera puede conectarse como cargador: definila siempre en producción.
# Mejor aún: contraseña propia por cargador con POST /api/chargers/<id>/ocpp-password.
OCPP_PASSWORD=
# 0 = no dar de alta solos los cargadores desconocidos (se cargan a mano en el panel)
OCPP_AUTO_REGISTER=1
# IPs de proxies en los que se confía para X-Forwarded-For (NGX). Nunca "true".
TRUST_PROXY=127.0.0.1,::1,192.168.99.75
# URL pública (para links de QR y retorno de pagos)
PUBLIC_URL=https://electricos.infratec.com.uy
# Mercado Pago (Access Token de producción de la cuenta de Infratec). Vacío = pagos online deshabilitados.
MP_ACCESS_TOKEN=
# Webhook para avisar alertas (Node-RED, WhatsApp, email). Recibe JSON con { text, kind, message, charger }.
ALERT_WEBHOOK_URL=
ALERT_OFFLINE_MINUTES=10
ALERT_STUCK_HOURS=14
