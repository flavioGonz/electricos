PORT=3000
DATABASE_URL=postgres://electricos:CAMBIAR@192.168.99.12:5432/electricos
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO
ADMIN_EMAIL=admin@infratec.com.uy
ADMIN_PASSWORD=CAMBIAR
TZ_LOCAL=America/Montevideo
# Contraseña opcional para cargadores (OCPP Security Profile 1, Basic Auth). Vacío = sin contraseña.
OCPP_PASSWORD=
# URL pública (para links de QR y retorno de pagos)
PUBLIC_URL=https://electricos.infratec.com.uy
# Mercado Pago (Access Token de producción de la cuenta de Infratec). Vacío = pagos online deshabilitados.
MP_ACCESS_TOKEN=
# Webhook para avisar alertas (Node-RED, WhatsApp, email). Recibe JSON con { text, kind, message, charger }.
ALERT_WEBHOOK_URL=
ALERT_OFFLINE_MINUTES=10
ALERT_STUCK_HOURS=14
